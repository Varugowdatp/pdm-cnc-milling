# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ---- Project data & artefacts ----
# The raw dataset is downloaded by src/data/download_dataset.py
data/raw/*.csv
data/raw/*.zip
# The expanded dataset is regenerated by src/data/expand_dataset.py (seeded)
data/processed/*.csv
# ...except the one the web app replays in the demo simulator (needed when hosted)
!data/processed/pdm_expanded_dataset.csv
# Trained model binaries
models/*.joblib
# ...except the bundle the web app loads (needed when hosted)
!models/pdm_model_bundle.joblib
# Runtime database
*.db
*.sqlite3
backend/*.db

# ---- Logs ----
artifacts/metrics/train_log.txt
*.log

